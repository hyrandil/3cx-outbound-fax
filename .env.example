# Kopiere diese Datei nach .env und fülle die Werte aus:
#   cp .env.example .env

# ── 3CX Fax-Nebenstelle ────────────────────────────────────────────────
# Extension-Nummer der Faxnebenstelle.
# 3CX: Admin → Erweitert → Fax → "+Hinzufügen".
# Man braucht KEINE DID; die Standardnummer der Extension = Fax-Server-Nummer,
# sonst Fallback.
SIP_EXTENSION=XX

# Auth-ID aus 3CX – ACHTUNG: weicht i.d.R. von der Extension-Nummer ab!
# 3CX: Benutzer → Telefon → "Authentifizierungs-ID"
SIP_AUTH_ID=DEINE_AUTH_ID

# Auth-Passwort aus 3CX (gleicher Ort wie die Auth-ID)
SIP_PASSWORD=DEIN_AUTH_PASSWORT

# ── SIP-Transport ──────────────────────────────────────────────────────
# 3CX Registrar (Cloud-Domain oder IP) + SIP-Port
SIP_PROXY=meine-anlage.on3cx.de
SIP_PORT=5060

# Lokaler SIP-Bind-Port von Asterisk. Der Container läuft im Host-Netz;
# Default 5062, damit UDP 5060 für einen SBC auf demselben Host frei bleibt.
SIP_BIND_PORT=5062

# ── Fax-Identität ──────────────────────────────────────────────────────
# Fax-Absendernummer / Caller-ID im E.164-Format.
# Analog zu SIP_EXTENSION (= Fax-Server-Nummer inbound) → In-/Outbound konsistent.
FAX_NUMBER=+4968XXXXXXX

# Name für den Fax-Header (optional, Freitext)
FAX_OWNER=Mein Fax

# ── Fax-API ────────────────────────────────────────────────────────────
# Port der Fax-API. Bindet im Host-Netz direkt am Host (8080 ist oft belegt).
# Der macOS-/Windows-Client muss auf denselben Port zeigen.
FAX_API_PORT=18080

# ── 3CX SBC (NUR Cloud-3CX, siehe docker-compose.sbc.yml) ──────────────
# On-Premise-3CX: gesamten Block auskommentiert lassen → Registrierung direkt
# an SIP_PROXY.
# Cloud-3CX (*.on3cx.de): 3CX verweigert direkte Registrierung (403). Daher
# SBC davorsetzen (docker-compose.sbc.yml) und Outbound-Proxy darauf zeigen.
# SBC läuft im Host-Netz auf demselben Host → Loopback 127.0.0.1.
# SIP_OUTBOUND_PROXY=127.0.0.1
#
# Aus 3CX Admin → SBCs (nach Anlegen eines SBC-Objekts):
# PBX_URL=https://deine-anlage.on3cx.de
# PBX_KEY=DEIN_SBC_AUTH_KEY
# SBC_VERSION=latest          # ggf. an 3CX-Hauptversion anpassen (z.B. 20.0)
